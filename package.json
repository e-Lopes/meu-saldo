{
  "name": "meu-saldo",
  "version": "1.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx index.ts src plugins app.json package.json tsconfig.json scripts/*.cjs",
    "release:prepare": "node scripts/bump_release.cjs",
    "format:check": "prettier --check App.tsx index.ts src plugins app.json package.json tsconfig.json scripts/*.cjs",
    "validate": "npm run typecheck && npm run format:check",
    "release:check": "python scripts/test_release_tools.py"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-modules-core": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
